{
  "name": "elgu-owner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/migrate.ts",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/seed.ts",
    "provision": "npm run migrate && npm run seed",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/owner.mjs",
    "set-password": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/set-password.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.2"
  }
}
