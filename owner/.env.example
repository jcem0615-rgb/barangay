# The owner portal's own database. Never a customer's.
OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/elgu_owner

# Seals each deployment's ops token at rest, so a dump of this database is a
# list of customers rather than a working key to every status endpoint.
#   openssl rand -hex 32
OWNER_TOKEN_KEY=

PORT=4500
NODE_ENV=production
TRUST_PROXY=1

# How often each deployment is asked how it is, and how long to wait.
OWNER_PROBE_INTERVAL_MS=300000
OWNER_PROBE_TIMEOUT_MS=8000
OWNER_SESSION_HOURS=8

# Only read by `npm run seed`, to create the first account.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
