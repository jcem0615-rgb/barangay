{
  "name": "elgu-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/migrate.ts",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/e2e.mjs",
    "test:rate-limit": "node test/rate-limit.mjs",
    "test:hardening": "node test/hardening.mjs"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
