# Which product this instance is — and these two are COMMENTED OUT ON PURPOSE,
# in the repository that is the barangay product. See SPLIT.md.
#
# This file is what `cp .env.example .env` gives a developer, and a developer
# runs the test suite. Only one suite (`test:tier`) sets the tier itself; the
# other ~40 run with it unset and therefore test the municipal tier. Worse,
# the server refuses to start when the tier and the database disagree — which
# is a check worth having, because an instance pointed at another barangay's
# database would serve that barangay's register and blotter to whoever signs
# in. So a `.env` that forced the barangay tier made `npm run seed` and the
# suite contradict each other on a fresh clone.
#
# **The tier is therefore stated where this repository actually deploys** —
# `render.yaml`, `docker-compose.yml` — and not here. Uncomment both (never
# one) to run the barangay tier locally, and reseed afterwards, because the
# database has to hold the one barangay this instance serves:
#
#   DEPLOYMENT_TIER=barangay BARANGAY_ID=poblacion npm run provision
#
# DEPLOYMENT_TIER=barangay
# BARANGAY_ID=poblacion

# Postgres connection string
DATABASE_URL=postgres://postgres@127.0.0.1:5432/elgu

# Secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start without this.
JWT_SECRET=

# Where the citizen/staff web app is served from (CORS allowlist, comma-separated).
# Note that http://localhost and http://127.0.0.1 are *different* origins to a
# browser — list both if you use both during development.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

PORT=4000

# Number of reverse proxies in front of this server (0 = directly exposed).
# Login rate limiting counts attempts per client IP, so this must match your
# deployment: too high and a client can forge X-Forwarded-For to evade the limit.
TRUST_PROXY=0

# Where resident-uploaded attachments are stored. In a container this MUST be a
# mounted volume, or every uploaded requirement is lost on the next deploy.
UPLOAD_DIR=./uploads

# clamd for scanning uploads. Leave unset to skip scanning (development only).
# When set, an upload that cannot be scanned is REJECTED rather than accepted
# unscanned — an unavailable scanner must not silently become no scanner.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Public address of the web app, used to build password reset links. Must be
# where residents actually reach the portal, not the server's own hostname.
PUBLIC_URL=http://localhost:5173

# Outbound mail. Without SMTP a resident who forgets their password has no way
# back into their account, so anything public needs this set.
#   console (default) - logs the message
#   file              - appends JSON lines to MAIL_OUTBOX (used by the tests)
#   smtp              - real delivery via SMTP_URL
MAIL_TRANSPORT=console
SMTP_URL=
MAIL_FROM=eBarangay Portal <no-reply@malasiqui.gov.ph>

# SMS notifications. In the Philippines a text reaches a resident far more
# reliably than email, but it is billed per message and needs a provider
# account, so it is off unless configured.
#   off (default) | log (prints) | http (posts to SMS_URL)
SMS_TRANSPORT=off
SMS_URL=
SMS_API_KEY=
SMS_SENDER=eBarangay
