# Postgres connection string
DATABASE_URL=postgres://postgres@127.0.0.1:5432/elgu

# Secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start without this.
JWT_SECRET=

# Where the citizen/staff web app is served from (CORS allowlist, comma-separated).
# Note that http://localhost and http://127.0.0.1 are *different* origins to a
# browser — list both if you use both during development.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

PORT=4000

# Number of reverse proxies in front of this server (0 = directly exposed).
# Login rate limiting counts attempts per client IP, so this must match your
# deployment: too high and a client can forge X-Forwarded-For to evade the limit.
TRUST_PROXY=0

# Where resident-uploaded attachments are stored. In a container this MUST be a
# mounted volume, or every uploaded requirement is lost on the next deploy.
UPLOAD_DIR=./uploads

# clamd for scanning uploads. Leave unset to skip scanning (development only).
# When set, an upload that cannot be scanned is REJECTED rather than accepted
# unscanned — an unavailable scanner must not silently become no scanner.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
