# Postgres connection string
DATABASE_URL=postgres://postgres@127.0.0.1:5432/elgu

# Secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start without this.
JWT_SECRET=

# Where the citizen/staff web app is served from (CORS allowlist, comma-separated).
# Note that http://localhost and http://127.0.0.1 are *different* origins to a
# browser — list both if you use both during development.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

PORT=4000
